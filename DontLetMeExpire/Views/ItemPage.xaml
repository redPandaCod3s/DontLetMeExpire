<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:system="clr-namespace:System;assembly=System.Runtime"
             xmlns:viewModels="clr-namespace:DontLetMeExpire.ViewModels"
             x:DataType="viewModels:ItemViewModel"
             x:Class="DontLetMeExpire.Views.ItemPage"
             Title="ItemPage"
             HideSoftInputOnTapped="True">
    <ScrollView>
        <Grid RowDefinitions="300, auto">
            <!-- Dummy Produktbild anzeigen -->
            <BoxView BackgroundColor="AliceBlue" HeightRequest="300"/>
            <Button Margin="16"
                    HorizontalOptions="End"
                    Text="Bild löschen"
                    VerticalOptions="Start"/>
            <FlexLayout AlignItems="Center"
                        Direction="Column"
                        JustifyContent="Center">
                <Image HeightRequest="48"
                       Source="dotnet_bot.png"
                       WidthRequest="48"/>
                <Label Text="Tippe hier, um ein Bild hinzuzufügen"/>
            </FlexLayout>
            
            <!-- Eingabefelder für das Produkt -->
            <VerticalStackLayout Grid.Row="1"
                                 Padding="16"
                                 Spacing="8">
                <Label Text="Name"/>
                <Entry Text="{Binding Name}"/>
                <Label Margin="0,8,0,0" Text="Lagerort" />
                <Picker ItemDisplayBinding="{Binding Name}"
                        ItemsSource="{Binding StorageLocations}"
                        SelectedItem="{Binding SelectedLocation}">
                </Picker>
                <Label Margin="0,8,0,0" Text="Verfallsdatum"/>
                <DatePicker Date="{Binding ExpirationDate}"/>
                <Label Margin="0,8,0,0" Text="Menge"/>
                <Entry Keyboard="Numeric" Text="{Binding Amount}"/>
                <Button Margin="0,8,0,0" 
                        Command="{Binding SaveCommand}"
                        Text="Speichern"/>
            </VerticalStackLayout>
        </Grid>
    </ScrollView>
</ContentPage>
<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:DontLetMeExpire.Controls"
             xmlns:models="clr-namespace:DontLetMeExpire.Models"
             xmlns:viewModels="clr-namespace:DontLetMeExpire.ViewModels"
             x:Class="DontLetMeExpire.MainPage"
             Padding="16"
             x:DataType="viewModels:MainViewModel"
             BackgroundColor="#f5f7fa">

    <ScrollView>
        <Grid RowDefinitions="100,100, auto,*, 48"
              ColumnDefinitions="*,*" RowSpacing="16" ColumnSpacing="16">
            
            <!-- Code für die Kachel "Mein Vorrat" -->
            <controls:DashboardTile
                Grid.Row="0"
                Grid.Column="0"
                Count="{Binding StockCount}"
                BorderColor="LightGray"
                Icon="dotnet_bot.png"
                Text="Mein Vorrat"
                Command="{Binding NavigateToStockCommand}"/>
            
            <!-- Code für die Kachel "Läuft bald ab" -->
            <controls:DashboardTile
                Grid.Row="0"
                Grid.Column="1"
                BorderColor="Green"
                Count="{Binding ExpiringSoonCount}"
                CountColor="Green"
                Icon="dotnet_bot.png"
                Text="Läuft bald ab"
                Command="{Binding NavigateToExpiringSoonCommand}"/>
            
            <!-- Code für die Kachel "Läuft heute ab" -->
            <controls:DashboardTile
                Grid.Row="1"
                Grid.Column="0"
                BorderColor="Orange"
                Count="{Binding ExpiresTodayCount}"
                CountColor="Orange"
                Icon="dotnet_bot.png"
                Text="Läuft heute ab"
                Command="{Binding NavigateToExpiresTodayCommand}"/>
            
            <!-- Code für die Kachel "Abgelaufen" -->
            <controls:DashboardTile
                Grid.Row="1"
                Grid.Column="1"
                BorderColor="Red"
                Count="{Binding ExpiredCount}"
                CountColor="Red"
                Icon="dotnet_bot.png"
                Text="Abgelaufen"
                Command="{Binding NavigateToExpiredCommand}"/>
            
            <Label Grid.Row="2" Grid.ColumnSpan="2" Margin="0,8,0,0"
                   Text="Meine Lagerorte" FontSize="24"/>
            
            <!-- Platzhalter für Lagerorte -->
            <VerticalStackLayout Grid.Row="3" 
                                 Grid.ColumnSpan="2" 
                                 Spacing="8"
                                 BindableLayout.ItemsSource="{Binding StorageLocations}"
                                 Padding="8">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="models:StorageLocationWithItemCount">
                    <Border BackgroundColor="White"
                            StrokeShape="RoundRectangle 16"
                            StrokeThickness="0">
                        <!-- Navigation zum aktuellen Lagerort ermöglichen -->
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer 
                                Command="{Binding Source={RelativeSource AncestorType={x:Type viewModels:MainViewModel}}, 
                                Path=NavigateToLocationCommand}" 
                                CommandParameter="{Binding Id}"/>
                        </Border.GestureRecognizers>
                        <!-- 
                            Definition des Schattens. Um natürlich zu wirken, 
                            kommt das Licht von oben (Offset x=0) 
                        -->
                          <Border.Shadow>
                                 <Shadow Opacity="0.2"
                                         Radius="4"
                                         Offset="0,4"/>
                          </Border.Shadow>
                          <!-- Grid mit zwei Zeilen und drei Spalten anlegen -->
                          <Grid Padding="8"
                                ColumnDefinitions="48, *, 24"
                                ColumnSpacing="8"
                                RowDefinitions="24, 24">
                                 <!-- Platzhalterbild in der ersten Spalte und beiden Zeilen,
                                          umgeben von einem hellblauen Kreis -->
                                 <Border Grid.Row="0"
                                         Grid.RowSpan="2"
                                         Grid.Column="0"
                                         BackgroundColor="AliceBlue"
                                         StrokeShape="RoundRectangle 45"
                                         StrokeThickness="0">
                                        <Image Source="dotnet_bot.png"/>
                                 </Border>
                                 <!-- Anzeige des Lagerortnamens -->
                                 <Label Grid.Column="1"
                                        FontAttributes="Bold"
                                        Text="{Binding Name}"/>
                                 <!-- Anzeige der Anzahl der Einträge -->
                                 <Label Grid.Row="1"
                                        Grid.Column="1"
                                        Text="{Binding ItemCount, StringFormat='{0} Einträge'}"
                                        TextColor="DarkGray"/>
                                 <!-- Darstellung eines einfachen Guillemet -->
                                 <Label Grid.RowSpan="2"
                                        Grid.Column="2"
                                        Margin="0,0,8,0"
                                        FontSize="36"
                                        HorizontalOptions="End"
                                        Text="›"
                                        VerticalOptions="Center"/>
                          </Grid>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
                
                <BindableLayout.EmptyViewTemplate>
                    <DataTemplate>
                        <VerticalStackLayout Spacing="8">
                            <Image Source="dotnet_bot.png" WidthRequest="150"/>
                            <Label Margin="0, 8, 0, 0"
                                   Style="{StaticResource SubHeadline}"
                                   Text="Oh, hier sieht es noch ganz leer aus!" />
                            <Label Text="Du hast noch keine Orte, wie z.B. einen Kühlschrank oder einen Vorratsschrank, in der App gespeichert, wo du deine Lebensmittel aufbewahren kannst."/>
                            <Label Margin="0,8,0,0"
                                   FontAttributes="Bold"
                                   Text="Los geht's!"/>
                            
                            <Label Text="Mit vorgeschlagenen Orten starten"
                                   TextColor="#3d6dcc"
                                   TextDecorations="Underline">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type viewModels:MainViewModel}},
                                                            Path=CreateSuggestedLocationsCommand}"/>
                                </Label.GestureRecognizers>
                            </Label>
                            <Label Margin="0, 8, 0, 0"
                                   Text="Mit vorgeschlagenen Orten und Lebensmitteln starten"
                                   TextColor="#3d6cc"
                                   TextDecorations="Underline">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource 
                                                            AncestorType={x:Type viewModels:MainViewModel}},
                                                            Path=CreateSuggestedLocationsAndStockCommand}"/>
                                </Label.GestureRecognizers>
                            </Label>
                            <Label FontSize="11" Text="Hier fügen wir nicht nur Orte wie 'Kühlschrank' hinzu, sondern auch einige Lebensmittel, damit du siehst, wie alles funktioniert! Du kannst Orte und Lebensmittel später natürlich auch umbenennen oder löschen"/>
                            <Label Margin="0,8,0,0"
                                   Text="Selbst einen Ort anlegen"
                                   TextColor="#3d6dcc"
                                   TextDecorations="Underline"/>
                            <Label FontSize="11" Text="Erstelle deinen eigenen Ort, wie z.B. deinen Kühlschrank, um zu beginnen."/>
                        </VerticalStackLayout>
                    </DataTemplate>
                </BindableLayout.EmptyViewTemplate>
            </VerticalStackLayout>
            <Button Grid.Row="4" 
                    Grid.Column="0" 
                    Text="Eintrag hinzufügen"
                    BackgroundColor="#3d6dcc"
                    Command="{Binding NavigateToAddItemCommand}"/>
            <Button Grid.Row="4" 
                    Grid.Column="1" 
                    Text="Neuen Ort anlegen"
                    BackgroundColor="White" 
                    BorderWidth="1"
                    BorderColor="#3d6dcc" 
                    TextColor="#3d6dcc"/>
        </Grid>
    </ScrollView>
</ContentPage>
